NODE_ENV=development
APP_MODE=development
DATABASE_URL=postgres://safesight:CHANGE_ME@127.0.0.1:55432/safesight
POSTGRES_USER=safesight
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=safesight
API_PORT=4000
API_HOST=127.0.0.1
WEB_PORT=3000
WEB_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_HOST=127.0.0.1
PUBLIC_APP_URL=
INFERENCE_URL=http://127.0.0.1:8001
INFERENCE_KEY=CHANGE_ME
INFERENCE_MODE=REAL
# Server-side vision inference. Never expose this key to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Use a project with billing DISABLED to stay on the free tier.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
STORAGE_ADAPTER=local
STORAGE_DIR=.runtime/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
COOKIE_SECURE=false

# Optional inference Python interpreter:
INFERENCE_PYTHON=

APP_FACILITY_ID=10000000-0000-4000-8000-000000000001
