{
  "name": "@safesight/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --include \"src/**/*.ts\" --include \"../../packages/*/src/**/*.ts\" --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@safesight/contracts": "workspace:*",
    "@safesight/db": "workspace:*",
    "cloudinary": "2.8.0",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "multer": "2.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0"
  }
}
